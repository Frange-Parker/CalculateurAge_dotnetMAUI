<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur">

   <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Nom" FontSize="16"/>
            
            <!-- Text lié à Nom du ViewModel, dans les deux sens -->
            <Entry Text="{Binding Nom, Mode=TwoWay}" Placeholder="Votre nom"/>
            <Label Text="Date de naissance" FontSize="16"/>
            
            <!-- Date liée à DateNaissance du ViewModel -->
            <DatePicker Date="{Binding DateNaissance, Mode=TwoWay}"/>
            
            <!-- Command remplace Clicked ; le bouton se grise tant que le nom est vide -->
            <Button Text="Calculer" Command="{Binding CalculerCommand}"/>
            
            <!-- Résultat-->
            <Label Text="{Binding Resultat}" FontSize="20"
                   IsVisible="{Binding ResultatVisible}"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
