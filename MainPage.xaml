<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur">

   <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <!-- Saisie du nom -->
            <Label Text="Nom" FontSize="16"/>
            <!-- Text lié à la propriété Nom du ViewModel -->
            <Entry Text="{Binding Nom, Mode=TwoWay}" Placeholder="Votre nom"/>

            <!-- Choix de la date de naissance -->
            <Label Text="Date de naissance" FontSize="16"/>
            <!-- Date liée à DateNaissance-->
            <DatePicker Date="{Binding DateNaissance, Mode=TwoWay}"/>

            <!-- Message d'erreur (date future), visible seulement s'il y a une erreur -->
            <Label Text="{Binding MessageErreur}" TextColor="Red"
                   IsVisible="{Binding ErreurVisible}"/>

            <!-- Boutons : Command est lié à une commande du ViewModel (il n y a plus de Clicked) -->
            <Button Text="Calculer" Command="{Binding CalculerCommand}"/>
            <Button Text="Effacer" Command="{Binding EffacerCommand}"/>

            <!-- Zone de résultat : visible seulement après un calcul -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding ResultatVisible}">
                <Label Text="{Binding Resultat}" FontSize="20"/>
                <Label Text="{Binding Statut}" FontSize="16" FontAttributes="Bold"/>
                <Label Text="{Binding ProchainAnniversaire}" FontSize="16"/>
                <Button Text="Voir le détail" Command="{Binding AfficherDetailsCommand}"/>
            </VerticalStackLayout>

            <!-- Historique des calculs -->
            <Label Text="Historique" FontSize="16" FontAttributes="Bold"/>
            <!-- BindableLayout : génère un Label par élément de la liste Historique -->
            <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Historique}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <!-- "." = l'élément courant -->
                        <Label Text="{Binding .}"/>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
